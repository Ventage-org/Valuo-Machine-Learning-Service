# ==============================================================================
# .env.example — Configuración Unificada del Stack MLOps (Valuo)
# ==============================================================================
# Copia este archivo como .env en la raíz para desplegar con Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ─── Puertos Públicos ──────────────────────────────────────────────────────────
PORT=8000
MLFLOW_PORT=5000

# ─── Base de Datos PostgreSQL ──────────────────────────────────────────────────
# Usar 'host.docker.internal' si PostgreSQL corre en la máquina host (Windows/Mac/Linux)
# o el nombre del contenedor/IP si PostgreSQL corre en Docker o en un servidor remoto.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=valuo_admin
DB_PASSWORD=V@aluo_admin

# Base de datos de entrenamiento e inferencia (dataset histórico y contexto)
DB_NAME=db_dataset_valuo

# Base de datos operacional de MLflow Tracking y Governance
DB_OPERACIONAL_NAME=db_operational_valuo
DB_SCHEMA=mlops

# ─── MLflow Experiments & Models ──────────────────────────────────────────────
MLFLOW_EXPERIMENT_VENTA=experimento_tasacion_venta
MLFLOW_EXPERIMENT_ALQUILER=experimento_tasacion_alquiler
MLFLOW_MODEL_NAME_VENTA=xgboost_venta
MLFLOW_MODEL_NAME_ALQUILER=xgboost_alquiler

# ─── Azure Blob Storage (Opcional - Artifact Store) ───────────────────────────
# Dejar vacío para usar almacenamiento local en volumen Docker (/mlflow/artifacts)
DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCESS_KEY=

# ─── Seguridad y Administración ───────────────────────────────────────────────
# Token para endpoints administrativos (/api/v1/admin/*). Dejar vacío para pruebas locales.
ADMIN_TOKEN=

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=*
