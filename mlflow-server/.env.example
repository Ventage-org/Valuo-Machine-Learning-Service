# ─── Servidor MLflow ─────────────────────────────────────────────────────────
MLFLOW_PORT=5000

# ─── Base de Datos Operacional (PostgreSQL) ──────────────────────────────────
# IMPORTANTE: No usar inmobiliaria_ml_db. Usar db_operacional_valuo con schema mlops.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_operacional_valuo
DB_SCHEMA=mlops
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── Artifact Store (Azure Blob Storage) ─────────────────────────────────────
# Opción 1: Desarrollo local en disco (default)
DEFAULT_ARTIFACT_ROOT=./artifacts

# Opción 2: Azure Blob Storage (Producción / Cloud)
# DEFAULT_ARTIFACT_ROOT=wasbs://ml-artifacts@tu_cuenta_storage.blob.core.windows.net/
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_ACCESS_KEY=tu_key_aqui
